<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FF2A2A2E" android:endColor="#FF161618" />
            <stroke android:width="2dp" android:color="#F5FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#F02A2A2E" android:endColor="#F0161618" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</selector>
